{
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "Tell me your hiring requirements",
      "weight": "Bolder",
      "size": "Medium"
    },
    {
      "type": "Input.Text",
      "id": "query",
      "placeholder": "Job requirements"
    },
    {
      "type": "Input.Number",
      "id": "salaryMin",
      "placeholder": "Salary min (€)"
    },
    {
      "type": "Input.Number",
      "id": "salaryMax",
      "placeholder": "Salary max (€)"
    },
    {
      "type": "Input.ChoiceSet",
      "id": "industry",
      "style": "compact",
      "placeholder": "Choose an industry",
      "choices": [
        { "title": "Teollisuus", "value": "Teollisuus" },
        { "title": "Logistiikka", "value": "Logistiikka" },
        { "title": "HoReCa", "value": "HoReCa" },
        { "title": "Rakennusala", "value": "Rakennusala" },
        { "title": "Turvallisuusala", "value": "Turvallisuusala" },
        { "title": "Terveydenhuolto", "value": "Terveydenhuolto" },
        { "title": "Satama-ala", "value": "Satama-ala" },
        { "title": "ICT / Teknologia", "value": "ICT / Teknologia" },
        { "title": "Kemia / Labra", "value": "Kemia / Labra" },
        { "title": "Ilmailu", "value": "Ilmailu" },
        { "title": "Opetusala", "value": "Opetusala" },
        { "title": "Puhtausala", "value": "Puhtausala" }
      ]
    },
    {
      "type": "Input.Number",
      "id": "distanceKm",
      "placeholder": "Distance from Lahti (km)"
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Search candidates"
    }
  ],
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json"
}
